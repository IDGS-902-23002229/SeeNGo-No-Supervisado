{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SEENGO: servidor en vivo (tablero web)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/consumidor/servidor.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "SEENGO: correr el modelo contra Atlas (una pasada)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/consumidor/consumir_mongo.py",
      "args": ["--dias", "90"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "SEENGO: sembrar Atlas (--dry-run, no escribe)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/datos/sembrar_atlas.py",
      "args": ["--dry-run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "SEENGO: sembrar Atlas (--limpiar, SÍ escribe)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/datos/sembrar_atlas.py",
      "args": ["--limpiar"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
